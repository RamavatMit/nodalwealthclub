# Copy to .env and fill in. Never commit .env.
# Generate passwords/salts with:  openssl rand -hex 32   (hex is URL-safe; base64 can break REDIS_URL)
# FIELD_ENCRYPTION_KEY is the exception: openssl rand -base64 32

# --- Phase 1 ---------------------------------------------------------------
SITE_URL=https://nodalwealthclub.example
# Bare domain for Caddy (no scheme)
SITE_DOMAIN=nodalwealthclub.example
# Salt for hashing IPs in rate-limit keys (min 16 chars)
RATE_LIMIT_SALT=
# Used by docker-compose for Redis and injected into REDIS_URL for the app
REDIS_PASSWORD=
# Local development without Docker (optional; falls back to in-memory limits)
# REDIS_URL=redis://localhost:6379

# --- Database (compose creates both users) ----------------------------------
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=

# --- Phase 2–4 (leave empty until the phase that needs them) ----------------
# 32 bytes base64, for AES-256-GCM field encryption
FIELD_ENCRYPTION_KEY=
AUTH_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
SENTRY_DSN=

# --- Backups (security/backups) ---------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_AGE_RECIPIENT=
